{
  "name": "project-gantt-master",
  "private": true,
  "version": "1.0.3-alpha",
  "author": "Allen Woo",
  "type": "module",
  "main": "electron/main.cjs",
  "homepage": "./",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "electron": "concurrently \"cross-env BROWSER=none npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:pack": "npm run build && electron-builder --dir",
    "electron:dist": "npm run build && electron-builder",
    "package-win": "npm run build && electron-packager . ProGantt --platform=win32 --arch=x64 --out=release-packager --overwrite --icon=public/assets/icon.ico --ignore=\"^/src$\" --ignore=\"^/node_modules$\" --ignore=\"^/.git$\" --ignore=\"^/.vscode$\" --ignore=\"^/release$\" --ignore=\"^/release-packager$\" --ignore=\"^/public$\" --ignore=\"^/.cache$\" --ignore=\"^/.agent$\" --ignore=\"^/docs$\" --ignore=\"\\.tsx$\" --ignore=\"\\.ts$\" --ignore=\"^/.*\\.md$\" --ignore=\"vite\\.config\" --ignore=\"tsconfig\" --ignore=\"^/index\\.html$\" --ignore=\"^/metadata\\.json$\" --ignore=\"^/test-results$\" --ignore=\"^/e2e$\"",
    "test": "npx tsx src/utils.test.ts && npx tsx src/dataParser.test.ts",
    "test:e2e": "npx playwright test"
  },
  "build": {
    "appId": "com.progantt.app",
    "productName": "ProGantt",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!e2e",
      "!test-results"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable"
    }
  },
  "dependencies": {
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "7zip-bin": "^5.2.0",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3",
    "electron-is-dev": "^3.0.1",
    "electron-packager": "^17.1.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.4",
    "wait-on": "^7.2.0"
  }
}